#!/usr/bin/env bash

set -euo pipefail

image="${1:-}"
cols="${FZF_PREVIEW_COLUMNS:-80}"
lines="${FZF_PREVIEW_LINES:-24}"
preview_dir="$HOME/Pictures/temp/page"
preview="$preview_dir/.kitty-preview.png"

mkdir -p "$preview_dir"

if [[ ! -s "$image" ]]; then
    exit 0
fi

width=$((cols * 8))
height=$((lines * 24))
magick "${image}[0]" -auto-orient -thumbnail "${width}x${height}>" -strip "$preview"
timeout 3 kitten icat --stdin=no --transfer-mode=memory --image-id=917 --align=center \
    --place="${cols}x${lines}@0x0" "$preview" || true
