#!/usr/bin/env python3
"""On-demand QML selector; compatible with the local dmenu/script callers.

No shell evaluation, no clipboard contents in argv or logs. Requests/results
live only in a private temporary runtime directory, removed on exit.
"""
import json
import os
from pathlib import Path
import re
import shlex
import signal
import subprocess
import sys
import tempfile

HOME = Path.home()
CONFIG = HOME / 'haku_shell/config/quickshell/haku-menu/shell.qml'
BAR = HOME / 'haku_shell/config/quickshell/minflair-niri/niri-preview.qml'


def options(argv):
    values = {}
    switches = {'-dmenu', '-i', '-show-icons', '-no-custom', '-markup-rows'}
    i = 0
    while i < len(argv):
        key = argv[i]
        if key in switches:
            values[key] = True
            i += 1
        elif i + 1 < len(argv):
            values[key] = argv[i + 1]
            i += 2
        else:
            raise ValueError('Falta valor para ' + key)
    return values


def parse_rows(output):
    rows, headers = [], {}
    for line in output.splitlines():
        if line.startswith('\0'):
            key, _, value = line[1:].partition('\x1f')
            headers[key] = value
            continue
        label, _, metadata = line.partition('\0')
        fields = metadata.split('\x1f')
        attrs = dict(zip(fields[::2], fields[1::2]))
        if label:
            rows.append({'label': label, 'icon': attrs.get('icon', ''),
                         'info': attrs.get('info', ''), 'index': len(rows)})
    return rows, headers


def theme():
    state = HOME / '.local/state/haku_theme'
    colors = (state / 'colors.css').read_text() if (state / 'colors.css').exists() else ''
    fonts = (state / 'fonts.css').read_text() if (state / 'fonts.css').exists() else ''
    accent = re.search(r'accent_color\s+(#[\da-fA-F]{6})', colors)
    family = re.search(r'font-family:\s*"([^"]+)"', fonts)
    return {'accent': accent[1] if accent else '#8d7c74',
            'font': family[1] if family else 'CommitMono Nerd Font'}


def select(request, config=CONFIG):
    runtime = os.environ.get('XDG_RUNTIME_DIR') or None
    with tempfile.TemporaryDirectory(prefix='haku-menu-', dir=runtime) as tmp:
        request_path = Path(tmp) / 'request.json'
        result_path = Path(tmp) / 'result.json'
        request_path.write_text(json.dumps({**theme(), **request, 'cacheDir': tmp}))
        result_path.touch(mode=0o600)
        env = {**os.environ, 'HAKU_MENU_REQUEST': str(request_path),
               'HAKU_MENU_RESULT': str(result_path)}
        command = ['quickshell', '-p', str(config)]
        if request.get('singleInstance'): command.append('--no-duplicate')
        proc = subprocess.Popen(command, env=env,
                                stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
        try:
            proc.communicate()
        finally:
            if proc.poll() is None:
                proc.terminate()
                try:
                    proc.wait(timeout=3)
                except subprocess.TimeoutExpired:
                    proc.kill()
                    proc.wait()
        if not result_path.stat().st_size:
            if proc.returncode:
                print('El selector QML no pudo abrirse.', file=sys.stderr)
            return {'code': 1, 'text': '', 'index': -1}
        return json.loads(result_path.read_text())


def run(argv):
    opts = options(argv)
    if opts.get('-show') in ('drun', 'run'):
        return subprocess.call(['quickshell', 'ipc', '-p', str(BAR), 'call',
                                'haku-launcher', 'toggleLauncher'])
    custom = [str(opts.get('-kb-custom-' + str(n), '')) for n in range(1, 4)]
    base = {'title': opts.get('-p', 'Haku'), 'message': opts.get('-mesg', ''),
            'customKeys': custom, 'allowCustom': not opts.get('-no-custom', False),
            'selected': int(opts.get('-selected-row', 0))}
    if opts.get('-dmenu'):
        rows, _ = parse_rows(sys.stdin.read())
        result = select({**base, 'rows': rows})
        if result['code'] != 1:
            fmt = opts.get('-format', 's')
            if fmt not in ('s', 'i', 'd'):
                raise ValueError('Formato no soportado: ' + str(fmt))
            print(result['index'] + (1 if fmt == 'd' else 0)
                  if fmt in ('i', 'd') else result['text'])
        return result['code']
    modes = []
    for mode in str(opts.get('-modes', '')).split(','):
        name, sep, command = mode.partition(':')
        if sep:
            modes.append((name, shlex.split(os.path.expandvars(os.path.expanduser(command)))))
    if not modes:
        raise ValueError('Usa -dmenu, -show drun o un modo de script explícito')
    mode_index = next((i for i, m in enumerate(modes) if m[0] == opts.get('-show')), 0)
    env = dict(os.environ, ROFI_RETV='0', ROFI_DATA='', ROFI_INFO='')
    selected = None
    while True:
        name, command = modes[mode_index]
        response = subprocess.run(command + ([] if selected is None else [selected]),
                                  env=env, stdout=subprocess.PIPE, text=True)
        rows, headers = parse_rows(response.stdout)
        if not rows:
            return response.returncode
        env['ROFI_DATA'] = headers.get('data', env.get('ROFI_DATA', ''))
        result = select({**base, 'title': headers.get('prompt', name),
                         'message': headers.get('message', base['message']),
                         'allowCustom': headers.get('no-custom', 'false') != 'true',
                         'rows': rows, 'modes': [m[0] for m in modes], 'mode': mode_index})
        if result['code'] == 1:
            return 1
        if result['code'] == 20:
            mode_index = (mode_index + 1) % len(modes)
            env.update(ROFI_RETV='0', ROFI_DATA='', ROFI_INFO='')
            selected = None
            continue
        selected = result['text']
        index = result['index']
        env['ROFI_INFO'] = rows[index]['info'] if 0 <= index < len(rows) else ''
        env['ROFI_RETV'] = str(result['code'] if result['code'] >= 10 else (1 if index >= 0 else 2))


if __name__ == '__main__':
    def terminate(signum, frame):
        raise KeyboardInterrupt
    signal.signal(signal.SIGTERM, terminate)
    try:
        sys.exit(run(sys.argv[1:]))
    except (ValueError, OSError, json.JSONDecodeError) as error:
        print('haku-qml-menu: ' + str(error), file=sys.stderr)
        sys.exit(2)
    except KeyboardInterrupt:
        sys.exit(1)
