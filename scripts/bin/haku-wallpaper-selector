#!/usr/bin/env python3
"""QML carousel backend. Keeps the existing transition/theme-sync contract."""
import fcntl
import hashlib
import json
import os
from pathlib import Path
import random
import re
import runpy
import signal
import subprocess
import sys
import tempfile
import time
import urllib.parse
import urllib.request

HOME = Path.home()
WALLS = HOME / 'Pictures/Wallpapers'
STATE = HOME / '.local/state/haku_theme'
CACHE = HOME / '.cache/haku-wallpaper-carousel/qml'
EXTENSIONS = {'.jpg', '.jpeg', '.png', '.webp', '.avif', '.gif'}


def current():
    try: return (STATE / 'current_wallpaper').read_text().strip()
    except OSError: return ''


def local_path(value):
    path = Path(value).resolve(strict=True)
    if path.parent != WALLS.resolve() or not path.is_file() or path.suffix.lower() not in EXTENSIONS:
        raise ValueError('Fondo fuera de la galería')
    return path


def catalog():
    WALLS.mkdir(parents=True, exist_ok=True)
    rows = [{'key': str(p.resolve()), 'path': str(p.resolve()), 'label': p.stem,
             'kind': 'local', 'id': '', 'resolution': ''}
            for p in sorted(WALLS.iterdir(), key=lambda p: p.name.casefold())
            if p.is_file() and p.suffix.lower() in EXTENSIONS and p.resolve().parent == WALLS.resolve()]
    return {'ok': True, 'rows': rows, 'current': current()}


def allowed_url(url):
    parts = urllib.parse.urlsplit(url)
    if parts.scheme != 'https' or parts.hostname not in {'wallhaven.cc', 'w.wallhaven.cc', 'th.wallhaven.cc'} or parts.username or parts.password:
        raise ValueError('URL de Wallhaven inválida')
    return url


def fetch(url, maximum):
    allowed_url(url)
    with urllib.request.urlopen(urllib.request.Request(url, headers={'User-Agent': 'HakuWallpaper/1.0'}), timeout=20) as response:
        allowed_url(response.geturl())
        data = response.read(maximum + 1)
    if len(data) > maximum: raise ValueError('La descarga supera el límite permitido')
    return data


def search(query, page):
    params = {'q': query, 'categories': '111', 'purity': '100', 'sorting': 'favorites',
              'order': 'desc', 'atleast': '1920x1080', 'ratios': '16x9', 'page': max(1, int(page))}
    keyfile = HOME / '.config/haku/wallhaven_api_key'
    if keyfile.is_file(): params['apikey'] = keyfile.read_text().strip()
    payload = json.loads(fetch('https://wallhaven.cc/api/v1/search?' + urllib.parse.urlencode(params), 4 * 1024 * 1024))
    rows = []
    for item in payload.get('data', []):
        if not re.fullmatch(r'[a-zA-Z0-9]{6}', item['id']): continue
        rows.append({'key': 'web:' + item['id'], 'id': item['id'], 'kind': 'web',
                     'label': item['id'], 'resolution': item['resolution'],
                     'thumb': allowed_url(item['thumbs']['small']), 'path': allowed_url(item['path'])})
    meta = payload.get('meta', {})
    return {'ok': True, 'rows': rows, 'total': meta.get('total', len(rows)),
            'lastPage': meta.get('last_page', 1), 'page': int(page), 'query': query}


def thumbnail(item):
    CACHE.mkdir(parents=True, exist_ok=True)
    if item['kind'] == 'local':
        source = local_path(item['path'])
        signature = f"qml-v1:{source}:{source.stat().st_mtime_ns}"
    else:
        allowed_url(item['thumb'])
        signature = 'qml-web-v1:' + item['thumb']
    target = CACHE / (hashlib.sha256(signature.encode()).hexdigest() + '.jpg')
    if target.is_file() and target.stat().st_size: return {'ok': True, 'key': item['key'], 'image': str(target)}
    with tempfile.TemporaryDirectory(prefix='thumb-', dir=CACHE) as temporary:
        if item['kind'] != 'local':
            source = Path(temporary) / 'source'
            source.write_bytes(fetch(item['thumb'], 8 * 1024 * 1024))
        output = Path(temporary) / 'thumb.jpg'
        subprocess.run(['magick', str(source) + '[0]', '-auto-orient', '-thumbnail', '420x300^',
                        '-gravity', 'center', '-extent', '420x300', '-strip', '-quality', '82', str(output)],
                       check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=20)
        output.replace(target)
    return {'ok': True, 'key': item['key'], 'image': str(target)}


def apply(item):
    if item['kind'] == 'web':
        url = allowed_url(item['path'])
        if not re.fullmatch(r'[a-zA-Z0-9]{6}', item['id']): raise ValueError('ID inválido')
        extension = Path(urllib.parse.urlsplit(url).path).suffix.lower()
        if extension not in EXTENSIONS: raise ValueError('Formato no soportado')
        WALLS.mkdir(parents=True, exist_ok=True)
        target = WALLS / ('wallhaven-' + item['id'] + extension)
        if not target.is_file() or not target.stat().st_size:
            data = fetch(url, 64 * 1024 * 1024)
            with tempfile.NamedTemporaryFile(dir=WALLS, suffix='.part', delete=False) as temporary:
                partial = Path(temporary.name)
                temporary.write(data)
            try: partial.replace(target)
            finally: partial.unlink(missing_ok=True)
    else:
        target = local_path(item['path'])
    STATE.mkdir(parents=True, exist_ok=True)
    with (STATE / 'wallpaper_selector_apply.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        previous = current()
        if previous == str(target.resolve()): return {'ok': True, 'current': previous, 'unchanged': True}
        generation = str(time.time_ns())
        # Same files, transition and delayed palette synchronization as GTK.
        for name, value in [('wallpaper_generation', generation), ('current_wallpaper', str(target.resolve()) + '\n')]:
            with tempfile.NamedTemporaryFile(mode='w', dir=STATE, delete=False) as tmp:
                tmp.write(value)
                temp_path = Path(tmp.name)
            temp_path.replace(STATE / name)
        subprocess.Popen([str(HOME / '.local/bin/wallpaper-transition'), previous, str(target),
                          random.choice(('left', 'right', 'top', 'bottom'))],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        subprocess.Popen([str(HOME / '.local/bin/wallpaper-theme-sync'), str(target), generation],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    return {'ok': True, 'current': str(target.resolve()), 'unchanged': False}


def worker(data):
    action = data['action']
    if action == 'list': return catalog()
    if action == 'search': return search(data.get('query', ''), data.get('page', 1))
    if action == 'thumb': return thumbnail(data['item'])
    if action == 'apply': return apply(data['item'])
    if action == 'trash':
        path = local_path(data['item']['path'])
        if str(path) == current(): raise ValueError('No se puede borrar el fondo activo')
        subprocess.run(['gio', 'trash', str(path)], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return catalog()
    raise ValueError('Acción desconocida')


def main():
    if '--worker' in sys.argv:
        try: result = worker(json.loads(sys.stdin.readline()))
        except Exception as error:
            # Do not leak API keys or full network URLs through exception messages.
            result = {'ok': False, 'error': str(error) if isinstance(error, ValueError) else 'No se pudo completar la operación. Reintenta.'}
        print(json.dumps(result))
        return 0 if result.get('ok') else 1
    config = HOME / 'haku_shell/config/quickshell/haku-wallpaper/shell.qml'
    # A second invocation closes the existing carousel instead of being ignored.
    closed = subprocess.run(
        ['quickshell', 'ipc', '-p', str(config), 'call', 'haku-wallpaper', 'close'],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if closed.returncode == 0:
        return 0
    bridge = runpy.run_path(str(HOME / 'haku_shell/scripts/bin/haku-qml-menu'))
    bridge['select']({**catalog(), 'title': 'Wallpapers', 'singleInstance': True},
                     config=config)
    return 0


if __name__ == '__main__':
    def terminate(signum, frame): raise KeyboardInterrupt
    signal.signal(signal.SIGTERM, terminate)
    try: sys.exit(main())
    except KeyboardInterrupt: sys.exit(0)
