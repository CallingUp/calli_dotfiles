#!/usr/bin/env bash
set -euo pipefail
binary="$HOME/haku_shell/tools/haku-clipboard/target/release/haku-clipboard"
if command -v haku-clipboard >/dev/null 2>&1; then exec haku-clipboard "$@"; fi
if [[ -x "$binary" ]]; then
    exec "$binary" "$@"
fi
exec python3 "$HOME/haku_shell/scripts/bin/haku-clipboard" "$@"
