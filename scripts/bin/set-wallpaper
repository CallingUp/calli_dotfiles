#!/usr/bin/env bash

set -euo pipefail

IMG="${1:-}"

if [[ -z "$IMG" ]]; then
    echo "Uso: set-wallpaper /ruta/a/imagen"
    exit 1
fi

if [[ ! -f "$IMG" ]]; then
    echo "Error: no existe: $IMG"
    exit 1
fi


# ============================================================
# Paths
# ============================================================

HAKU_ACCENT="$HOME/.local/bin/get_accent_color.py"

NIRI_ACCENT="$HOME/.config/niri/accent.kdl"
HAKU_STATE="$HOME/.local/state/haku_theme"
BACKDROP="$HAKU_STATE/blurred-backdrop.png"
KITTY_COLORS="$HOME/.config/kitty/colors.conf"
CURRENT_WALLPAPER="$HAKU_STATE/current_wallpaper"

mkdir -p "$HAKU_STATE"


# ============================================================
# Blurred backdrop
# ============================================================

echo "1..."

magick "${IMG}[0]" \
    -background black \
    -alpha remove \
    -blur 0x15 \
    "$BACKDROP"


# ============================================================
# Accent extraction
#
# ============================================================

echo "2..."

if [[ ! -f "$HAKU_ACCENT" ]]; then
    echo "Error: no existe $HAKU_ACCENT"
    exit 1
fi

ACCENT="$(
    python "$HAKU_ACCENT" "$IMG" |
        tail -n1 |
        tr -d '\r\n'
)"


if ! [[ "$ACCENT" =~ ^#[0-9A-Fa-f]{6}$ ]]; then
    echo "Color inválido obtenido de Haku: $ACCENT"
    ACCENT="#89b4fa"
fi


# Protect against colors that are too dark

R=$((16#${ACCENT:1:2}))
G=$((16#${ACCENT:3:2}))
B=$((16#${ACCENT:5:2}))

if (( R + G + B < 180 )); then
ACCENT="$(
    magick xc:"$ACCENT" \
        -depth 8 \
        -modulate 135,110,100 \
        -depth 8 \
        -format '#%[hex:p{0,0}]' \
        info:
)"
fi


# Active color

ACTIVE="$(
    magick xc:"$ACCENT" \
        -depth 8 \
        -modulate 105,108,100 \
        -depth 8 \
        -format '#%[hex:p{0,0}]' \
        info:
)"

# Inactive color

INACTIVE="$(
    magick xc:"$ACCENT" \
        -depth 8 \
        -modulate 48,78,100 \
        -depth 8 \
        -format '#%[hex:p{0,0}]' \
        info:
)"

# Niri accent

cat > "$NIRI_ACCENT" <<EOF
// ============================================================
// Dynamic accent
// ============================================================

layout {
    border {
        on
        active-color "$ACTIVE"
        inactive-color "$INACTIVE"
    }
}
EOF


# Shared Haku color state

cat > "$HAKU_STATE/colors.css" <<EOF
/* Generated by set-wallpaper */
@define-color accent_color $ACCENT;
@define-color accent_active $ACTIVE;
@define-color accent_inactive $INACTIVE;
EOF

ROFI_FONT_SIZE=14
FONT_CONFIG="$HOME/.config/font/config"
if [[ -r "$FONT_CONFIG" ]]; then
    source "$FONT_CONFIG"
    shell_size_var="SIZE_${CURRENT}_SHELL"
    ROFI_FONT_SIZE="${!shell_size_var:-14}"
fi

cat > "$HAKU_STATE/rofi-style.rasi" <<EOF
/* Generated by set-wallpaper */
* {
    font: "Iosevka Nerd Font $ROFI_FONT_SIZE";
    accent: $ACCENT;
    accent-active: $ACTIVE;
    accent-inactive: $INACTIVE;
}
EOF

cat > "$KITTY_COLORS" <<EOF
# Generated by set-wallpaper
background            #000000
foreground            #d8daea
selection_background  $INACTIVE
selection_foreground  #ffffff
cursor                $ACCENT
cursor_text_color     #000000
url_color             $ACTIVE
active_border_color   $ACCENT
inactive_border_color $INACTIVE
bell_border_color     $ACCENT

active_tab_foreground   #000000
active_tab_background   $ACCENT
inactive_tab_foreground $ACCENT
inactive_tab_background #000000
tab_bar_background      #000000

color0  #15151d
color1  #d2768c
color2  #8fb59b
color3  #c7aa78
color4  $ACCENT
color5  #aa8fba
color6  #83b6af
color7  #d8daea
color8  #62647c
color9  #e08da0
color10 #a4c7aa
color11 #d8bd8a
color12 $ACTIVE
color13 #bca3cc
color14 #9dccc6
color15 #ffffff
EOF

"$HOME/.local/bin/haku-ytmd-theme"
"$HOME/.local/bin/haku-pear-theme"

"$HOME/.local/bin/haku-noctalia-theme" "$ACCENT"
"$HOME/.local/bin/haku-greeter-sync" "$IMG" "$ACCENT" "$ACTIVE" "$INACTIVE" "$BACKDROP"
wallpaper_path="$(realpath "$IMG")"
printf '%s\n' "$wallpaper_path" > "$CURRENT_WALLPAPER"
"$HOME/.local/bin/haku-lock-background" "$wallpaper_path"


# Wallpaper

echo "3..."

awww img "$IMG" \
    --transition-type random \
    --transition-step 90 \
    --transition-fps 60


# Overview backdrop

echo "4..."

awww img \
    -n "awww-daemon-backdrop" \
    "$BACKDROP"


# Reload Niri

if niri validate >/dev/null 2>&1; then
    niri msg action load-config-file >/dev/null
else
    echo
    echo "ERROR: el accent.kdl generado hizo inválida la configuración."
    niri validate
    exit 1
fi


# Result

echo
echo "Wallpaper:        $IMG"
echo ""
echo ""
kitten icat $IMG
echo "Haku accent:      $ACCENT"
echo "Borde activo:     $ACTIVE"
echo "Borde inactivo:   $INACTIVE"
