#!/usr/bin/env bash

set -euo pipefail

IMG="${1:-}"
FAST_APPLY="${HAKU_WALLPAPER_FAST:-0}"
SYNC_ONLY="${HAKU_WALLPAPER_SYNC_ONLY:-0}"
GENERATION="${HAKU_WALLPAPER_GENERATION:-}"

if [[ -z "$IMG" ]]; then
    echo "Uso: set-wallpaper /ruta/a/imagen"
    exit 1
fi

if [[ ! -f "$IMG" ]]; then
    echo "Error: no existe: $IMG"
    exit 1
fi


# ============================================================
# Paths
# ============================================================

HAKU_ACCENT="$HOME/.local/bin/get_accent_color.py"

NIRI_ACCENT="$HOME/.config/niri/accent.kdl"
HAKU_STATE="$HOME/.local/state/haku_theme"
BACKDROP="$HAKU_STATE/blurred-backdrop.png"
KITTY_COLORS="$HOME/.config/kitty/colors.conf"
CURRENT_WALLPAPER="$HAKU_STATE/current_wallpaper"

mkdir -p "$HAKU_STATE"

generation_is_current() {
    [[ -z "$GENERATION" || ( -r "$HAKU_STATE/wallpaper_generation" && "$(<"$HAKU_STATE/wallpaper_generation")" == "$GENERATION" ) ]]
}

if [[ "$FAST_APPLY" == "1" && "$SYNC_ONLY" != "1" ]]; then
    transition="$(shuf -n 1 -e left right top bottom)"
    "$HOME/.local/bin/haku-wallpaper-render" "$IMG" "$transition" >/dev/null 2>&1 &
fi


# ============================================================
# Blurred backdrop
# ============================================================

echo "1..."

magick "${IMG}[0]" \
    -resize '1280x720^' \
    -gravity center \
    -extent 1280x720 \
    -background black \
    -alpha remove \
    -blur 0x15 \
    "$BACKDROP"

if [[ "$SYNC_ONLY" == "1" ]] && ! generation_is_current; then
    exit 0
fi

awww img \
    -n "awww-daemon-backdrop" \
    "$BACKDROP" \
    --transition-type fade \
    --transition-duration 0.35 \
    --transition-fps 60 >/dev/null 2>&1 &


# Fixed palette: never extract colors from the wallpaper.
source "$HOME/.config/haku/palette.conf"
for color in "$ACCENT" "$ACTIVE" "$INACTIVE"; do
    [[ "$color" =~ ^#[0-9A-Fa-f]{6}$ ]] || { echo "Invalid fixed palette color"; exit 1; }
done

# Niri accent

cat > "$NIRI_ACCENT" <<EOF
// ============================================================
// Dynamic accent
// ============================================================

recent-windows {
    highlight { active-color "$ACCENT"; }
}

layout {
    border {
        on
        active-color "$ACTIVE"
        inactive-color "$INACTIVE"
    }
}
EOF


# Shared Haku color state

cat > "$HAKU_STATE/colors.css" <<EOF
/* Generated by set-wallpaper */
@define-color accent_color $ACCENT;
@define-color accent_active $ACTIVE;
@define-color accent_inactive $INACTIVE;
EOF

ROFI_FONT_SIZE=14
FONT_CONFIG="$HOME/.config/font/config"
if [[ -r "$FONT_CONFIG" ]]; then
    source "$FONT_CONFIG"
    shell_size_var="SIZE_${CURRENT}_SHELL"
    ROFI_FONT_SIZE="${!shell_size_var:-14}"
fi

cat > "$HAKU_STATE/rofi-style.rasi" <<EOF
/* Generated by set-wallpaper */
* {
    font: "0xProto Nerd Font $ROFI_FONT_SIZE";
    accent: $ACCENT;
    accent-active: $ACTIVE;
    accent-inactive: $INACTIVE;
}
EOF

cat > "$KITTY_COLORS" <<EOF
# Generated by set-wallpaper
background            #000000
foreground            #E8DCC8
selection_background  $INACTIVE
selection_foreground  #F5EBDC
cursor                $ACCENT
cursor_text_color     #000000
url_color             $ACTIVE
active_border_color   $ACCENT
inactive_border_color $INACTIVE
bell_border_color     $ACCENT

active_tab_foreground   #000000
active_tab_background   $ACCENT
inactive_tab_foreground $ACCENT
inactive_tab_background #000000
tab_bar_background      #000000

color0  #211813
color1  #BF616A
color2  #A3BE8C
color3  #B99573
color4  $ACCENT
color5  #C5A48C
color6  #B99573
color7  #E8DCC8
color8  #967F6B
color9  #BF616A
color10 #A3BE8C
color11 #D7B894
color12 $ACTIVE
color13 #C5A48C
color14 #D7B894
color15 #F5EBDC
EOF

if [[ "$SYNC_ONLY" == "1" ]] && ! generation_is_current; then
    exit 0
fi

"$HOME/.local/bin/haku-ytmd-theme"
"$HOME/.local/bin/haku-pear-theme"
"$HOME/.local/bin/haku-sddm-pixie-sync" "$IMG" "$ACCENT"

if [[ "$SYNC_ONLY" != "1" ]] || generation_is_current; then
    wallpaper_path="$(realpath "$IMG")"
    printf '%s\n' "$wallpaper_path" > "$CURRENT_WALLPAPER"
fi


# Wallpaper

echo "3..."

if [[ "$FAST_APPLY" != "1" && "$SYNC_ONLY" != "1" ]]; then
    "$HOME/.local/bin/haku-wallpaper-render" "$IMG" "$(shuf -n 1 -e left right top bottom)"
fi


# Reload Niri

if niri validate >/dev/null 2>&1; then
    niri msg action load-config-file >/dev/null
else
    echo
    echo "ERROR: el accent.kdl generado hizo inválida la configuración."
    niri validate
    exit 1
fi


# Result

echo
echo "Wallpaper:        $IMG"
echo ""
echo ""
if [[ -t 1 && -n "${KITTY_WINDOW_ID:-}" ]]; then
    kitten icat "$IMG" || true
fi
echo "Haku accent:      $ACCENT"
echo "Borde activo:     $ACTIVE"
echo "Borde inactivo:   $INACTIVE"
