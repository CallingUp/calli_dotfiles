#!/usr/bin/env bash

set -euo pipefail

IMG="${1:?}"
ACCENT="${2:?}"
ACTIVE="${3:?}"
INACTIVE="${4:?}"
BLURRED_SOURCE="${5:-}"
STATE_DIR="/var/lib/noctalia-greeter"
WALLPAPER="$STATE_DIR/wallpaper-haku.jpg"
CONFIG="$STATE_DIR/greeter.toml"

if [[ ! -w "$STATE_DIR" ]]; then
    exit 0
fi

wallpaper_tmp="$(mktemp "$STATE_DIR/.wallpaper-haku.XXXXXX.jpg")"
config_tmp="$(mktemp "$STATE_DIR/.greeter.XXXXXX.toml")"
sharp_tmp="$(mktemp "$STATE_DIR/.wallpaper-sharp.XXXXXX.png")"
blur_tmp="$(mktemp "$STATE_DIR/.wallpaper-blur.XXXXXX.png")"
card_tmp="$(mktemp "$STATE_DIR/.wallpaper-card.XXXXXX.png")"
trap 'rm -f "$wallpaper_tmp" "$config_tmp" "$sharp_tmp" "$blur_tmp" "$card_tmp"' EXIT

magick "${IMG}[0]" \
    -auto-orient \
    -resize '1920x1080^' \
    -gravity center \
    -extent 1920x1080 \
    "$sharp_tmp"

if [[ -n "$BLURRED_SOURCE" && -f "$BLURRED_SOURCE" ]]; then
    magick "$BLURRED_SOURCE" -resize '1920x1080^' -gravity center -extent 1920x1080 "$blur_tmp"
else
    magick "$sharp_tmp" -blur 0x18 "$blur_tmp"
fi

magick "$blur_tmp" \
    -crop 540x240+690+420 +repage \
    \( -size 540x240 xc:none -fill white -draw 'roundrectangle 0,0 539,239 14,14' \) \
    -alpha off -compose CopyOpacity -composite \
    "$card_tmp"

magick "$sharp_tmp" "$card_tmp" \
    -geometry +690+420 -compose over -composite \
    -quality 92 \
    "$wallpaper_tmp"

cat > "$config_tmp" <<EOF
[session]
default = "Niri"

[user]
default = "calli"

[appearance]
scheme = "Synced"
password_style = "default"
hide_logo = true
power_buttons_position = "bottom-right"
scheme_selector_position = "hidden"
theme_mode = "dark"
corner_radius_scale = 1.15
font_family = "Iosevka Nerd Font"

[appearance.palette]
primary = "$ACCENT"
on_primary = "#08090D"
secondary = "$ACTIVE"
on_secondary = "#08090D"
tertiary = "$ACCENT"
on_tertiary = "#08090D"
error = "#E06C75"
on_error = "#08090D"
surface = "#08090D"
on_surface = "#E8EAF0"
surface_variant = "#11131AC7"
on_surface_variant = "#A8ACB8"
outline = "$INACTIVE"
shadow = "#000000"
hover = "$ACTIVE"
on_hover = "#08090D"

[appearance.wallpaper]
path = "$WALLPAPER"
fill_mode = "crop"
fill_color = "#08090D"

[output]
name = "eDP-1"
scale = 1.0

[idle]
timeout = 300

[keyboard]
layout = "latam"
numlock = true
EOF

chmod 0644 "$wallpaper_tmp" "$config_tmp"
mv -f "$wallpaper_tmp" "$WALLPAPER"
mv -f "$config_tmp" "$CONFIG"
trap - EXIT
