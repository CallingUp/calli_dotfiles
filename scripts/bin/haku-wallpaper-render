#!/usr/bin/env python3
import os, socket, sys
sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
sock.connect(os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "haku-wallpaper-renderer.sock"))
sock.sendall(f"{sys.argv[1]}\t{sys.argv[2] if len(sys.argv) > 2 else 'none'}".encode()); sock.close()
