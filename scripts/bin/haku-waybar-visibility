#!/usr/bin/env bash

# Compatibility entry point used by the existing Niri bindings. The bar is
# now a Quickshell surface; keeping this filename means the keybinds need no
# migration and makes rolling back to Waybar trivial.
set -euo pipefail

config="$HOME/haku_shell/config/quickshell/minflair-niri/niri-preview.qml"
case "${1:-}" in
    show)
        # Keep the running shell and its media state instead of restarting it.
        if ! quickshell ipc -p "$config" call haku-bar revealBar; then
            systemctl --user start haku-quickshell.service
        fi
        ;;
    hide)
        quickshell ipc -p "$config" call haku-bar hide
        ;;
    next|previous)
        quickshell ipc -p "$config" call haku-bar "$1"
        ;;
    *)
        printf 'Uso: %s {show|hide}\n' "$0" >&2
        exit 2
        ;;
esac
