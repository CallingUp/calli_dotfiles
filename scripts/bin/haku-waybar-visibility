#!/usr/bin/env bash

# Compatibility entry point used by the existing Niri bindings. The bar is
# now a Quickshell surface; keeping this filename means the keybinds need no
# migration and makes rolling back to Waybar trivial.
set -euo pipefail

case "${1:-}" in
    show)
        # Quickshell 0.3.2's IPC introspection works here, but its calls do
        # not reliably flip a PanelWindow after it has been unmapped. Starting
        # the user unit is deterministic and re-creates the reserved surface.
        systemctl --user restart haku-quickshell.service
        ;;
    hide)
        systemctl --user stop haku-quickshell.service
        ;;
    *)
        printf 'Uso: %s {show|hide}\n' "$0" >&2
        exit 2
        ;;
esac
