#!/bin/sh

dir="/tmp/haku-panel-hover-$UID"
waybar="$dir/waybar"
panel="$dir/panel"
active="$dir/active"
opened="$dir/opened"
generation="$dir/generation"

mkdir -p "$dir"
[ -f "$generation" ] || printf '0\n' >"$generation"

bump() {
    value=$(cat "$generation" 2>/dev/null)
    value=${value:-0}
    value=$((value + 1))
    printf '%s\n' "$value" >"$generation"
    printf '%s\n' "$value"
}

close_later() {
    token=$(bump)

    (
        sleep 0.4
        current=$(cat "$generation" 2>/dev/null)
        [ "$current" = "$token" ] || exit 0
        [ -e "$waybar" ] && exit 0
        [ -e "$panel" ] && exit 0

        panel_id=$(cat "$active" 2>/dev/null)
        [ -n "$panel_id" ] && noctalia msg panel-close "$panel_id" >/dev/null 2>&1
        rm -f "$active" "$opened"
    ) &
}

open_later() {
    panel_id="$1"
    shift
    context="$*"
    token=$(bump)
    # The control center belongs to the centered media/system/actions capsule.
    # Do not use the raw pointer coordinate for it: a click near either edge of
    # the capsule made the whole panel appear visibly off-center. Session stays
    # pointer-anchored at the right as intended.
    anchor=""
    if [ "$panel_id" != "control-center" ] && [ -n "$HAKU_HOVER_X" ] && [ -n "$HAKU_HOVER_Y" ]; then
        anchor="@anchor=$HAKU_HOVER_X,$HAKU_HOVER_Y"
    fi
    signature="$panel_id|$context|$anchor"

    (
        sleep 0.12
        current=$(cat "$generation" 2>/dev/null)
        [ "$current" = "$token" ] || exit 0
        [ -e "$waybar" ] || exit 0
        [ "$(cat "$active" 2>/dev/null)" = "$panel_id" ] || exit 0
        [ "$(cat "$opened" 2>/dev/null)" = "$signature" ] && exit 0
        if noctalia msg panel-open "$panel_id" "$anchor${context:+ $context}" >/dev/null 2>&1; then
            printf '%s\n' "$signature" >"$opened"
        fi
    ) &
}

case "$1" in
    waybar-enter)
        bump >/dev/null
        touch "$waybar"
        active_id="$2"
        panel_id="$3"
        printf '%s\n' "$active_id" >"$active"
        shift 3
        open_later "$panel_id" "$@"
        ;;
    waybar-leave)
        rm -f "$waybar"
        close_later
        ;;
    waybar-toggle)
        active_id="$2"
        panel_id="$3"
        shift 3
        context="$*"
        # Keep central panels centered even when their trigger was clicked at
        # the far left or right of the Waybar capsule.
        anchor=""
        if [ "$panel_id" != "control-center" ] && [ -n "$HAKU_HOVER_X" ] && [ -n "$HAKU_HOVER_Y" ]; then
            anchor="@anchor=$HAKU_HOVER_X,$HAKU_HOVER_Y"
        fi
        signature="$panel_id|$context|$anchor"
        if [ "$(cat "$opened" 2>/dev/null)" = "$signature" ]; then
            noctalia msg panel-close "$panel_id" >/dev/null 2>&1
            rm -f "$active" "$opened" "$waybar"
        else
            bump >/dev/null
            touch "$waybar"
            printf '%s\n' "$active_id" >"$active"
            if noctalia msg panel-open "$panel_id" "$anchor${context:+ $context}" >/dev/null 2>&1; then
                printf '%s\n' "$signature" >"$opened"
            fi
        fi
        ;;
    panel-enter)
        [ "$(cat "$active" 2>/dev/null)" = "$2" ] || exit 0
        bump >/dev/null
        touch "$panel"
        ;;
    panel-leave)
        [ "$(cat "$active" 2>/dev/null)" = "$2" ] || exit 0
        rm -f "$panel"
        close_later
        ;;
    reset)
        rm -rf "$dir"
        ;;
esac
