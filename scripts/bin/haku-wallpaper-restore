#!/usr/bin/env bash

set -euo pipefail

state="$HOME/.local/state/haku_theme"
current="$state/current_wallpaper"
backdrop="$state/blurred-backdrop.png"

[[ -r "$current" ]] || exit 0
wallpaper="$(head -n 1 "$current")"
[[ -f "$wallpaper" ]] || exit 0

for _ in {1..20}; do
    if awww query >/dev/null 2>&1 && awww query -n awww-daemon-backdrop >/dev/null 2>&1; then
        break
    fi
    sleep 0.25
done

if [[ ! -f "$backdrop" || "$wallpaper" -nt "$backdrop" ]]; then
    magick "${wallpaper}[0]" -background black -alpha remove -blur 0x15 "$backdrop"
fi

"$HOME/.local/bin/haku-lock-background" "$wallpaper"

awww img "$wallpaper" --transition-type none
awww img -n awww-daemon-backdrop "$backdrop" --transition-type none
