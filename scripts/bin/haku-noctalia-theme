#!/usr/bin/env python3

import colorsys
import json
import re
import shutil
import subprocess
import sys
from pathlib import Path


def rgb(value):
    value = value.lstrip("#")
    return tuple(int(value[index:index + 2], 16) for index in (0, 2, 4))


def hex_color(value):
    return "#{:02x}{:02x}{:02x}".format(*(max(0, min(255, round(channel))) for channel in value))


def mix(first, second, amount):
    return hex_color(tuple(a + (b - a) * amount for a, b in zip(rgb(first), rgb(second))))


def tone(value, lightness, saturation_scale=1.0):
    red, green, blue = (channel / 255 for channel in rgb(value))
    hue, current_lightness, saturation = colorsys.rgb_to_hls(red, green, blue)
    output = colorsys.hls_to_rgb(hue, lightness, min(1.0, saturation * saturation_scale))
    return hex_color(tuple(channel * 255 for channel in output))


accent = sys.argv[1] if len(sys.argv) > 1 else ""
if not re.fullmatch(r"#[0-9A-Fa-f]{6}", accent):
    raise SystemExit("Uso: haku-noctalia-theme '#RRGGBB'")

accent = accent.lower()
active = tone(accent, min(0.78, colorsys.rgb_to_hls(*(channel / 255 for channel in rgb(accent)))[1] + 0.05), 1.05)
hover = mix("#000000", accent, 0.24)

dark = {
    "mPrimary": accent,
    "mOnPrimary": "#000000",
    "mSecondary": active,
    "mOnSecondary": "#000000",
    "mTertiary": tone(accent, 0.72, 0.72),
    "mOnTertiary": "#000000",
    "mError": "#ff5f74",
    "mOnError": "#000000",
    "mSurface": "#000000",
    "mOnSurface": "#f2f0ed",
    "mSurfaceVariant": "#000000",
    "mOnSurfaceVariant": active,
    "mOutline": accent,
    "mShadow": "#000000",
    "mHover": hover,
    "mOnHover": "#ffffff",
    "terminal": {
        "background": "#000000",
        "foreground": "#f2f0ed",
        "cursor": accent,
        "cursorText": "#000000",
        "selectionBg": hover,
        "selectionFg": "#ffffff",
        "normal": {
            "black": "#000000",
            "red": "#ff5f74",
            "green": accent,
            "yellow": active,
            "blue": accent,
            "magenta": tone(accent, 0.72, 0.72),
            "cyan": active,
            "white": "#f2f0ed",
        },
        "bright": {
            "black": "#555555",
            "red": "#ff7b8d",
            "green": active,
            "yellow": tone(accent, 0.80, 0.85),
            "blue": active,
            "magenta": tone(accent, 0.80, 0.72),
            "cyan": tone(accent, 0.80, 0.85),
            "white": "#ffffff",
        },
    },
}

palette_dir = Path.home() / ".config/noctalia/palettes"
palette_dir.mkdir(parents=True, exist_ok=True)
target = palette_dir / "haku-dynamic.json"
temporary = target.with_suffix(".json.tmp")
temporary.write_text(json.dumps({"dark": dark}, indent=2) + "\n")
temporary.replace(target)

if shutil.which("noctalia"):
    try:
        subprocess.run(
            ["noctalia", "msg", "config-reload"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=3,
            check=False,
        )
    except subprocess.TimeoutExpired:
        pass
