{
    "include": [
        "$HOME/.config/waybar/module/workspace_module",
        "$HOME/.config/waybar/module/notification_module",
        "$HOME/.config/waybar/module/music_module",
        "$HOME/.config/waybar/module/monitor_module"
    ],
    "layer": "top",
    "position": "top",
    "margin-bottom": 0,
    "margin-left": 6,
    "margin-right": 6,
    "spacing": 0,
    "tooltip": true,
    "reload_style_on_change": true,

    "modules-left": [
        "custom/logo",
        "group/hworkspaces",
        "clock",
        "custom/recorder"
    ],
    "modules-center": [
        "group/player"
    ],
    "modules-right": [
        "group/monitor",
        "group/settings",
        "custom/notification",
        "custom/session"
    ],

    "clock": {
        "format": " {:%H:%M:%S, %d %B %Y} ",
        "format-alt": " {:%A, %d %B %Y} ",
        "interval": 1,
        "tooltip-format": "<span size='x-large'><b>{:%Y %B}</b></span>\n<span size='large'><tt>{calendar}</tt></span>",
        "calendar": {
            "mode"          : "month",
            "mode-mon-col"  : 3,
            "weeks-pos"     : "right",
            "on-scroll"     : 1,
            "format": {
                "months":     "<b>{}</b>",
                "days":       "{}",
                "weeks":      "<span alpha='55%'>W{}</span>",
                "weekdays":   "<b>{}</b>",
                "today":      "<b><u>{}</u></b>"
            }
        },
        "actions":  {
            "on-click": "noctalia msg panel-toggle control-center",
            "on-click-right": "mode",
            "on-scroll-up": "tz_up",
            "on-scroll-down": "tz_down"
        }
    },

    "group/player": {
    "orientation": "horizontal",
    "modules": [
        "mpris",
        "cava"
    ]
    },

    "custom/media-prev": {
        "format": "󰒮",
        "on-click": "noctalia msg media previous",
        "tooltip": false
    },

    "custom/media-next": {
        "format": "󰒭",
        "on-click": "noctalia msg media next",
        "tooltip": false
    },

    "group/settings": {
        "orientation": "horizontal",
        "modules": [
            "custom/settings",
            "battery",
            "power-profiles-daemon",
            "tray"
        ]
    },

    "group/monitor": {
        "orientation": "horizontal",
        "modules": [
            "custom/monitor",
            "cpu",
            "memory",
            "temperature"
        ]
    },

    "group/media": {
        "orientation": "horizontal",
        "modules": [
            "pulseaudio",
            "pulseaudio/slider",
            "backlight",
            "backlight/slider"
        ]
    },
    
    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["", "", "", "", "", "", "", "", ""],
        "on-scroll-up": "brightnessctl set 1%+",
        "on-scroll-down": "brightnessctl set 1%-",
        "on-click": "$HOME/.local/bin/nightlight_toggle.sh",
        "tooltip-format": "Brightness: {percent}%"
    },

    "backlight/slider": {
        "min": 10,
        "max": 100,
        "orientation": "horizontal"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-icons": {
            "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
            "charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
            "plugged": [""]
        },
        "tooltip-format": "Battery: {capacity}%\nPower: {power}W\n{timeTo}",
        "tooltip": true
    },

    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
        "tooltip": true,
        "format-icons": {
            "default": "",
            "performance": "",
            "balanced": "",
            "power-saver": ""
        }
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 ",
        "format-icons": {
            "headphone": "󰋋",
            "default": ["", "", ""]
        },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol",
        "tooltip-format": "Volume: {volume}%"
    },

    "pulseaudio/slider": {
        "min": 0,
        "max": 100,
        "orientation": "horizontal"
    },

    "tray": {
        "icon-size": 18,
        "spacing": 10,
        "icon-theme": "Tela-black-dark",
        "icons": {
            "nm-applet": "/home/calli/.icons/Tela-black-dark/24/panel/network-wireless-signal-excellent.svg",
            "steam": "/home/calli/.icons/Tela-black-dark/24/panel/steam_tray_mono.svg",
            "discord": "/home/calli/.icons/Tela-black-dark/24/panel/discord-tray.svg"
        },
        "show-passive-items": true
    },

    "custom/recorder": {
        "exec": "if [ -f /tmp/recording_time ]; then cat /tmp/recording_time; fi",
        "interval": 1,
        "format": " {text}",
        "return-type": "plain",
        "if-file-exists": "/tmp/recording_pid",
        "hide-empty-text": true,
        "on-click": "$HOME/.local/bin/record.sh",
        "tooltip": true,
        "tooltip-format": "Stop recording"
    },

    "custom/settings": {
        "format": "",
        "tooltip-format": "Centro de control",
        "tooltip": false,
        "on-click": "$HOME/.local/bin/haku-panel-hover waybar-toggle control-center control-center",
        "on-mouse-enter": "$HOME/.local/bin/haku-panel-hover waybar-enter control-center control-center",
        "on-mouse-leave": "$HOME/.local/bin/haku-panel-hover waybar-leave",
        "on-click-right": "noctalia msg settings-toggle"
    },

    "custom/monitor": {
        "format": "",
        "tooltip-format": "Monitor del sistema",
        "tooltip": false,
        "on-click": "$HOME/.local/bin/haku-panel-hover waybar-toggle control-center control-center system",
        "on-mouse-enter": "$HOME/.local/bin/haku-panel-hover waybar-enter control-center control-center system",
        "on-mouse-leave": "$HOME/.local/bin/haku-panel-hover waybar-leave"
    },

    "custom/session": {
        "format": "",
        "tooltip-format": "Menú de sesión",
        "tooltip": true,
        "on-click": "noctalia msg panel-toggle session"
    },

    "custom/logo": {
        "format": "󰮯",
        "tooltip-format": "Abrir launcher",
        "tooltip": false,
        "on-mouse-enter": "$HOME/.local/bin/haku-panel-hover waybar-enter launcher launcher",
        "on-mouse-leave": "$HOME/.local/bin/haku-panel-hover waybar-leave",
        "on-click": "$HOME/.local/bin/haku-panel-hover waybar-toggle launcher launcher"
    }
}
