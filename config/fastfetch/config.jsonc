{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "/home/calli/Pictures/fastfetch-icon/icon.png",
        "type": "kitty",
        "position": "left",
        "width": 28,
        "height": 14,
        "preserveAspectRatio": true,
        "padding": {
            "left": 0,
            "right": 2,
            "top": 0
        },
        "color": { "1": "white" }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "white", "output": "white", "title": "white" },
        "constants": ["\u001b[37m", "\u001b[37m"]
    },
    "modules": [
        {
            "type": "command",
            "key": " ",
            "text": "echo \"      ╭─$2$1 $USER-Space─╮\""
        },
        {
            "type": "custom",
            "key": "│---------------│"
        },
        {
            "type": "kernel",
            "key": "│  {$2}{$1}  kernel    │"
        },
        {
            "type": "os",
            "key": "│  {$2}{$1}  os        │"
        },
        {
            "type": "wm",
            "key": "│  {$2}{$1}  wm        │"
        },
        {
            "type": "terminal",
            "key": "│  {$2}{$1}  terminal  │"
        }, 
        {
            "type": "disk",
            "key": "│  {$2}{$1}  disk      │",
            "folder": "/"
        },
        {
            "type": "memory",
            "key": "│  {$2}{$1}  memory    │"
        },
        {
            "type": "swap",
            "key": "│  {$2}󰍛{$1}  swap      │"
        },
        {
            "type": "gpu",
            "key": "│  {$2}󰟻{$1}  gpu       │"
        },
        {
            "type": "packages",
            "key": "│  {$2}{$1}  pkgs      │"
        },
        {
            "type": "custom",
            "key": "╰───────────────╯"
        },
        {
            "type": "colors",
            "key": " ",
            "symbol": "circle"
        }
    ]
}
