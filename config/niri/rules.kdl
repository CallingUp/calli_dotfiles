// ------------------------------------------------------------
// Application rules
// ------------------------------------------------------------

// Firefox Picture-in-Picture
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

window-rule {
    match title="About Mozilla Firefox"
    open-floating true
}

// Dolphin
window-rule {
    match app-id="org.kde.dolphin"
    opacity 1.0
}

window-rule {
    match app-id="org.kde.dolphin" title="Choose Application — Dolphin"

    default-column-width {
        fixed 450
    }

    default-window-height {
        fixed 500
    }
}

// Pavucontrol
window-rule {
    match app-id="org.pulseaudio.pavucontrol"
    open-floating true
}

// NetworkManager
window-rule {
    match app-id="nm-connection-editor"
    open-floating true
}

// Image viewer
window-rule {
    match app-id="imv"
    open-floating true
}

// ------------------------------------------------------------
// Application-specific opacity adjustments
// ------------------------------------------------------------

// Firefox
window-rule {
    match app-id="firefox"
    opacity 1.0
}

// Kitty
window-rule {
    match app-id="kitty"
    opacity 1.0
}

// Helium
window-rule {
    match app-id="helium-browser"
    opacity 1.0
}

// Pear Desktop
window-rule {
    match app-id="com.github.th-ch.youtube-music"

    default-column-width {
        fixed 560
    }
}

// ------------------------------------------------------------
// Layer rules
// ------------------------------------------------------------

layer-rule {
    match namespace="notifications"
    opacity 1.0
}

// Awww backdrop
layer-rule {
    match namespace="^awww-daemonawww-daemon-backdrop$"
    place-within-backdrop true
}
